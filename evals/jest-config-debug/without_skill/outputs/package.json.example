{
  "name": "my-wordpress-plugin",
  "version": "1.0.0",
  "description": "WordPress Plugin with Jest Testing",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:debug": "node --inspect-brk ./node_modules/.bin/jest --runInBand",
    "test:ci": "jest --coverage --watchAll=false --detectOpenHandles"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@wordpress/babel-preset-default": "^6.25.0",
    "@wordpress/blocks": "^11.18.0",
    "@wordpress/components": "^21.8.0",
    "@wordpress/element": "^5.4.1",
    "@wordpress/hooks": "^3.48.0",
    "@wordpress/i18n": "^4.48.0",
    "@wordpress/api-fetch": "^6.48.0",
    "@wordpress/data": "^8.50.0",
    "@wordpress/block-editor": "^12.18.0",
    "babel-jest": "^29.5.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "jest-watch-typeahead": "^2.2.2"
  },
  "optionalDevDependencies": {
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}

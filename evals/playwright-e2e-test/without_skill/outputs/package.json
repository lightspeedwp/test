{
  "name": "wordpress-block-plugin-e2e-tests",
  "version": "1.0.0",
  "description": "Playwright E2E tests for WordPress block plugin release workflow",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:tablet": "playwright test --project=iPad",
    "test:responsive": "playwright test --project='Mobile Chrome' --project=iPad --project=chromium",
    "test:a11y": "playwright test --grep @a11y",
    "test:error-scenarios": "playwright test --grep '@error'",
    "test:visual": "playwright test --grep '@visual'",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "trace": "playwright show-trace"
  },
  "keywords": [
    "wordpress",
    "block",
    "e2e",
    "testing",
    "playwright",
    "gutenberg",
    "plugin"
  ],
  "author": "LightSpeed WP",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

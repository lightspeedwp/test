# WordPress Configuration
BASE_URL=http://localhost:8889
WP_ADMIN_URL=http://localhost:8889/wp-admin

# WordPress Admin Credentials (if needed for automated login)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=password

# Test Configuration
CI=false
HEADED=false
SLOW_MO=0

# Browser Configuration
BROWSER=chromium
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

# Test Timeouts
TEST_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000

# Screenshot/Video Settings
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
TRACE_ON_FAILURE=true

# Accessibility Checking
CHECK_ACCESSIBILITY=true
CHECK_CONTRAST=true

# Custom Block Plugin Settings
CUSTOM_BLOCK_NAME=Custom Block
CUSTOM_BLOCK_CATEGORY=common

# Performance Testing
MEASURE_PERFORMANCE=true
MAX_LCP_MS=2500
MAX_INP_MS=100
MAX_CLS=0.1

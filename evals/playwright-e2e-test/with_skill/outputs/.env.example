# WordPress E2E Test Configuration

# Base URL of WordPress installation
BASE_URL=http://localhost:8080

# WordPress Test Credentials
WP_TEST_USERNAME=admin
WP_TEST_PASSWORD=password
WP_TEST_EMAIL=admin@example.local

# Plugin Configuration
PLUGIN_SLUG=custom-feature-block
PLUGIN_NAME=Custom Feature Block
BLOCK_NAME=Custom Feature Block
BLOCK_NAMESPACE=lightspeedwp

# Test Timeouts (milliseconds)
TEST_TIMEOUT=30000
NAV_TIMEOUT=30000
ACTION_TIMEOUT=10000

# Test Execution
TEST_RETRIES=2
MAX_FAILURES=0
WORKERS=1
HEADLESS=true

# Debug Options
SLOW_MOTION=0
DEBUG=false

# Visual Regression
UPDATE_SNAPSHOTS=false

# Environment
NODE_ENV=test
TEST_ENV=local

# Optional: Proxy Configuration
HTTP_PROXY=
HTTP_USER=
HTTP_PASSWORD=

# Optional: Authentication
HTTP_AUTH_USERNAME=
HTTP_AUTH_PASSWORD=

# Optional: Staging/Production URLs
STAGING_URL=https://staging.example.com
PRODUCTION_URL=https://example.com

# CI/CD Configuration
CI=false
SKIP_SERVER=false
SKIP_GLOBAL_SETUP=false
SKIP_GLOBAL_TEARDOWN=false

# Reporting
REPORT_FORMAT=html
REPORT_DIR=test-results

# Performance Targets
LCP_TARGET=2500
FID_TARGET=100
CLS_TARGET=0.1

# Accessibility Standards
A11Y_CONTRAST_RATIO=7
A11Y_MIN_TOUCH_TARGET=44
A11Y_MIN_TEXT_SIZE=14

# Video/Screenshot Options
SCREENSHOT_MODE=only-on-failure
VIDEO_MODE=retain-on-failure
TRACE_MODE=on-first-retry

# Browser Configuration
BROWSER_ARGS=--disable-dev-shm-usage

# Logging
LOG_LEVEL=info
VERBOSE=false

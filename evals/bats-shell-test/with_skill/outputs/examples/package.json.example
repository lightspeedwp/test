{
  "name": "wordpress-theme",
  "version": "1.0.0",
  "description": "WordPress block theme with comprehensive testing",
  "license": "GPL-2.0-or-later",
  "author": "LightSpeedWP",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "build": "npm run build:theme && npm run build:webpack",
    "build:theme": "node scripts/validate-theme.js",
    "build:webpack": "webpack --mode=production",
    "dev": "webpack serve --mode=development",
    "watch": "webpack --watch --mode=development",
    "test": "npm run test:jest && npm run test:bats",
    "test:jest": "jest --coverage",
    "test:bats": "bats tests/*.bats",
    "test:coverage": "jest --coverage --collectCoverageFrom='src/**/*.js'",
    "test:watch": "jest --watch",
    "coverage:check": "node scripts/check-coverage.js --threshold=100",
    "validate:theme": "node scripts/validate-theme.json",
    "validate:all": "npm run validate:theme && npm run coverage:check",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write 'src/**/*.{js,jsx,css,md}'",
    "format:check": "prettier --check 'src/**/*.{js,jsx,css,md}'",
    "prebuild": "npm run lint && npm run test:coverage",
    "prepare": "npm run validate:all",
    "predeploy": "npm run build && npm run test && npm run coverage:check",
    "deploy": "node scripts/deploy.js",
    "release": "standard-version && npm publish",
    "clean": "rm -rf build dist coverage node_modules",
    "reinstall": "npm run clean && npm install"
  },
  "dependencies": {
    "@wordpress/blocks": "^12.0.0",
    "@wordpress/components": "^25.0.0",
    "@wordpress/dom-ready": "^4.0.0",
    "@wordpress/element": "^5.0.0",
    "@wordpress/i18n": "^4.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.0.0",
    "babel-jest": "^29.5.0",
    "babel-loader": "^9.1.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "prettier": "^3.0.0",
    "standard-version": "^9.5.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"],
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "identity-obj-proxy"
    },
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/*.test.{js,jsx}",
      "!src/index.js",
      "!src/**/__mocks__/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/src/**/*.test.js"
    ]
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "babel": {
    "presets": [
      ["@babel/preset-env", { "targets": { "node": "current" } }],
      "@babel/preset-react"
    ]
  }
}
